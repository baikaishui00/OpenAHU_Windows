{
  "openapi": "3.1.0",
  "info": {
    "title": "OpenAHU Local API",
    "version": "3.1.0",
    "description": "本地SQLite演示API；所有路径须携带 X-OpenAHU-Session 会话头，不访问学校站点。"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:{port}",
      "variables": {
        "port": {
          "default": "54321",
          "description": "运行时以session.json中的随机端口替换"
        }
      }
    }
  ],
  "security": [
    {
      "localSession": []
    }
  ],
  "components": {
    "securitySchemes": {
      "localSession": {
        "type": "apiKey",
        "in": "header",
        "name": "X-OpenAHU-Session"
      }
    },
    "schemas": {
      "ApiError": {
        "type": "object",
        "required": [
          "code",
          "message",
          "traceId"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "traceId": {
            "type": "string"
          }
        }
      },
      "HealthDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ]
          },
          "databaseReady": {
            "type": "boolean"
          },
          "version": {
            "type": "string"
          }
        }
      },
      "DataStatusDto": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "example": "LocalSQLite"
          },
          "isDemo": {
            "type": "boolean"
          },
          "updatedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "message": {
            "type": "string",
            "example": "本地演示数据，非学校官方信息"
          }
        }
      },
      "StudentProfileDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "college": {
            "type": [
              "string",
              "null"
            ]
          },
          "major": {
            "type": [
              "string",
              "null"
            ]
          },
          "gradeYear": {
            "type": [
              "integer",
              "null"
            ]
          },
          "isDemo": {
            "type": "boolean"
          }
        }
      },
      "TermDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "startDate": {
            "type": "string",
            "format": "date"
          },
          "weekCount": {
            "type": "integer"
          },
          "isCurrent": {
            "type": "boolean"
          }
        }
      },
      "CourseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "teacher": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "dayOfWeek": {
            "type": "integer",
            "minimum": 0,
            "maximum": 6
          },
          "startSection": {
            "type": "integer"
          },
          "endSection": {
            "type": "integer"
          },
          "weekNumbers": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "termId": {
            "type": "string"
          }
        }
      },
      "CourseUpsertRequest": {
        "type": "object",
        "required": [
          "name",
          "teacher",
          "location",
          "dayOfWeek",
          "startSection",
          "endSection",
          "weekNumbers",
          "termId"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "teacher": {
            "type": "string",
            "maxLength": 100
          },
          "location": {
            "type": "string",
            "maxLength": 150
          },
          "dayOfWeek": {
            "type": "integer",
            "minimum": 0,
            "maximum": 6
          },
          "startSection": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "endSection": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "weekNumbers": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30
            }
          },
          "termId": {
            "type": "string"
          }
        }
      },
      "GradeDto": {
        "type": "object",
        "properties": {
          "courseId": {
            "type": "string"
          },
          "courseName": {
            "type": "string"
          },
          "credits": {
            "type": "number"
          },
          "score": {
            "type": [
              "number",
              "null"
            ]
          },
          "gradePoint": {
            "type": [
              "number",
              "null"
            ]
          },
          "termId": {
            "type": "string"
          }
        }
      },
      "ExamDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "courseName": {
            "type": "string"
          },
          "startsAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "endsAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "location": {
            "type": [
              "string",
              "null"
            ]
          },
          "termId": {
            "type": "string"
          }
        }
      },
      "LinkDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "category": {
            "type": "string"
          }
        }
      }
    }
  },
  "paths": {
